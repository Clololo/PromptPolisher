<Window x:Class="PromptPolisher.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="600" Width="980"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        Background="#F3F4F6">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Providers -->
            <TabItem Header="模型提供方">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ProviderList"
                             Grid.Column="0"
                             ItemsSource="{Binding Providers}"
                             SelectedItem="{Binding SelectedProvider}"
                             DisplayMemberPath="DisplayName"
                             Margin="0,0,12,0" />

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="提供方配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="ID（只读）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.Id, Mode=OneWay}" IsReadOnly="True" Background="#F9FAFB" />

                            <TextBlock Text="显示名称" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="类型（只读）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.KindText, Mode=OneWay}" IsReadOnly="True" Background="#F9FAFB" />

                            <CheckBox Content="启用该提供方" IsChecked="{Binding SelectedProvider.Enabled}" Margin="0,8,0,4" />

                            <TextBlock Text="Base URL（API）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="模型 / Endpoint ID" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.Model, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="登录 URL（网页版）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.LoginUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="聊天 URL（网页版）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.ChatUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="备注" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding SelectedProvider.Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="52" VerticalContentAlignment="Top" />

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="API Key（仅 API 提供方）" FontWeight="SemiBold" Foreground="#1E3A8A" />
                                    <TextBlock Text="密钥保存在 Windows Credential Manager（或 DPAPI 加密文件），不会写入配置或日志。"
                                               TextWrapping="Wrap" Foreground="#1E3A8A" FontSize="11" Margin="0,4,0,8" />
                                    <PasswordBox x:Name="ApiKeyBox" Padding="6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="保存密钥" Click="SaveKey_Click" />
                                        <Button Content="清除密钥" Click="ClearKey_Click" />
                                        <TextBlock Text="{Binding ApiKeyStatus}" VerticalAlignment="Center"
                                                   Foreground="#6B7280" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Template -->
            <TabItem Header="系统 Prompt 模板">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#374151" Margin="0,0,0,8">
                        可用占位符：{{user_prompt}}、{{strength}}、{{style}}、{{language}}、{{length}}、
                        {{preserve_terms}}、{{format}}、{{preserve_meaning}}、{{extra_instructions}}。
                        模板必须包含 {{user_prompt}}。
                        修改后保存到 %LocalAppData%\PromptPolisher\system-prompt.txt，重启后仍然生效；
                        “恢复默认”读取程序目录 config\system-prompt.default.txt。
                    </TextBlock>

                    <TextBox Grid.Row="1"
                             Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             VerticalContentAlignment="Top" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="恢复默认" Command="{Binding ResetTemplateCommand}" />
                        <Button Content="校验模板" Command="{Binding ValidateTemplateCommand}" />
                        <TextBlock Text="{Binding ValidationMessage}" VerticalAlignment="Center"
                                   Foreground="#2563EB" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- General -->
            <TabItem Header="通用">
                <StackPanel Margin="10" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="默认提供方" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedDefaultProvider}"
                              DisplayMemberPath="DisplayName" />

                    <CheckBox Content="保存历史记录（SQLite）" IsChecked="{Binding SaveHistory}" Margin="0,10,0,4" />
                    <CheckBox Content="在历史中保存 Prompt 正文（关闭则只存元数据）"
                              IsChecked="{Binding StorePromptContent}" Margin="0,4,0,4" />
                    <CheckBox Content="默认流式显示" IsChecked="{Binding StreamByDefault}" Margin="0,4,0,4" />
                    <CheckBox Content="默认同意网页版自动化合规声明（不建议）"
                              IsChecked="{Binding WebAutomationConsent}" Margin="0,4,0,4" />

                    <TextBlock Text="默认超时（秒）" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />

                    <TextBlock Text="默认重试次数" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Click="Cancel_Click" />
            <Button Content="保存" Click="Save_Click" Background="#2563EB" Foreground="White"
                    BorderBrush="#2563EB" FontWeight="SemiBold" Padding="24,6" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
