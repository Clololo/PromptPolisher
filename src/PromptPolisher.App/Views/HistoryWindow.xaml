<Window x:Class="PromptPolisher.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Height="600" Width="1000"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        Background="#F3F4F6">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="360" Padding="6" />
            <Button Content="搜索" Command="{Binding SearchCommand}" Margin="8,0,8,0" Padding="12,5" />
            <Button Content="删除选中" Command="{Binding DeleteCommand}" Margin="0,0,8,0" Padding="12,5" />
            <Button Content="清空全部" Command="{Binding ClearCommand}" Padding="12,5" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowBackground="White"
                  AlternatingRowBackground="#F9FAFB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Width="150"
                                    Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                <DataGridTextColumn Header="提供方" Width="120" Binding="{Binding ProviderId}" />
                <DataGridTextColumn Header="模型" Width="120" Binding="{Binding Model}" />
                <DataGridTextColumn Header="状态" Width="80" Binding="{Binding Status}" />
                <DataGridTextColumn Header="耗时(ms)" Width="90" Binding="{Binding DurationMs}" />
                <DataGridTemplateColumn Header="原始 Prompt" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OriginalPrompt}" TextTrimming="CharacterEllipsis"
                                       MaxHeight="22" VerticalAlignment="Center" ToolTip="{Binding OriginalPrompt}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="润色结果" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PolishedPrompt}" TextTrimming="CharacterEllipsis"
                                       MaxHeight="22" VerticalAlignment="Center" ToolTip="{Binding PolishedPrompt}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#6B7280" Margin="0,8,0,0" />
    </Grid>
</Window>
