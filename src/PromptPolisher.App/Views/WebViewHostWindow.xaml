<Window x:Class="PromptPolisher.App.Views.WebViewHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Web Session" Height="600" Width="900"
        Left="-20000" Top="-20000"
        WindowStyle="None" ShowInTaskbar="False"
        Background="#111827">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="LoginBar" Grid.Row="0" Background="#111827" Padding="10" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="LoginTitle" Foreground="White" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="完成登录" Click="CompleteLogin_Click"
                        Padding="14,5" Background="#2563EB" Foreground="White"
                        BorderBrush="#2563EB" Cursor="Hand" />
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>
