<Window x:Class="PromptPolisher.App.Views.ManualResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动模式" Height="600" Width="820"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        Background="#F3F4F6">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="手动模式（最合规）" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="HeaderText" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="1. 复制下面的 Prompt 到网页版" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Button DockPanel.Dock="Bottom" Content="复制 Prompt" Click="CopyPrompt_Click"
                    HorizontalAlignment="Left" Padding="12,5" Margin="0,6,0,0" />
            <TextBox x:Name="PromptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Padding="6"
                     VerticalContentAlignment="Top" />
        </DockPanel>

        <TextBlock Grid.Row="2" Text="2. 把网页版返回的结果粘贴到下面" FontWeight="SemiBold" Margin="0,12,0,4" />

        <TextBox Grid.Row="3" x:Name="ResultBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Padding="6"
                 VerticalContentAlignment="Top" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="使用此结果" Click="Ok_Click" Padding="20,6"
                    Background="#2563EB" Foreground="White" BorderBrush="#2563EB" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
