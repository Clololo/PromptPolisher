<Window x:Class="PromptPolisher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Prompt 润色工具"
        Icon="Assets/app.ico"
        Height="620" Width="1120" MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=InputTextBox}"
        FontFamily="Microsoft YaHei UI"
        Background="#F3F4F6">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding PolishCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Prompt 润色工具" FontSize="24" FontWeight="Bold" Foreground="#111827" />
                <TextBlock Text="官方 API 优先 · 网页版实验性 · 手动模式兜底"
                           Foreground="#6B7280" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="模型提供方" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#374151" />
                <ComboBox ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          DisplayMemberPath="DisplayName"
                          Width="230" Margin="0,0,8,0" />
                <Button Content="设置" Command="{Binding OpenSettingsCommand}" />
                <Button Content="历史" Command="{Binding OpenHistoryCommand}" Margin="0" />
            </StackPanel>
        </DockPanel>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Input -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="原始 Prompt" Style="{StaticResource Label}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding InputCharCount, StringFormat=字符数：{0}}"
                                   Foreground="#6B7280" VerticalAlignment="Center" />
                        <Button Content="清空" Command="{Binding ClearCommand}" HorizontalAlignment="Right" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="InputTextBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="14"
                             VerticalContentAlignment="Top" />
                </DockPanel>
            </Border>

            <!-- Parameters -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="润色参数" Style="{StaticResource Label}" Margin="0,0,0,4" FontSize="14" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="润色强度" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding StrengthOptions}" SelectedItem="{Binding SelectedStrength}" DisplayMemberPath="DisplayName" />

                            <TextBlock Text="目标风格" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}" DisplayMemberPath="DisplayName" />

                            <TextBlock Text="输出语言" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" />

                            <TextBlock Text="长度控制" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding LengthOptions}" SelectedItem="{Binding SelectedLength}" DisplayMemberPath="DisplayName" />

                            <TextBlock Text="输出格式" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="DisplayName" />

                            <CheckBox Content="保留原意（不改变核心意图）" IsChecked="{Binding PreserveMeaning}" Margin="0,8,0,4" />
                            <CheckBox Content="流式显示" IsChecked="{Binding StreamOutput}" Margin="0,4,0,4" />

                            <TextBlock Text="必须保留的术语" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding PreserveTerms, UpdateSourceTrigger=PropertyChanged}" Height="30" />

                            <TextBlock Text="额外要求" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ExtraInstructions, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="58"
                                     VerticalContentAlignment="Top" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="超时（秒）" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="重试次数" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,10,0,0"
                                    Visibility="{Binding SelectedProvider.IsWeb, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="网页版为实验性功能" FontWeight="SemiBold" Foreground="#9A3412" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#9A3412" FontSize="11" Margin="0,4,0,6"
                                               Text="网页自动化可能违反平台条款。必须确认平台允许，且应用不会绕过验证码/风控。" />
                                    <CheckBox Content="我确认平台允许自动化，并遵守其条款"
                                              IsChecked="{Binding WebAutomationConsent}"
                                              Foreground="#9A3412" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Output -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="润色结果" Style="{StaticResource Label}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="复制结果" Command="{Binding CopyCommand}" />
                        <Button Content="导出 .txt" Command="{Binding ExportCommand}" />
                        <Button Content="重新润色" Command="{Binding RepolishCommand}" />
                        <TextBlock Text="{Binding OutputCharCount, StringFormat=字符数：{0}}"
                                   Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TabControl>
                        <TabItem Header="结果">
                            <TextBox Text="{Binding OutputText, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontSize="14"
                                     Background="#F9FAFB" BorderThickness="0"
                                     VerticalContentAlignment="Top" />
                        </TabItem>
                        <TabItem Header="对比">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock DockPanel.Dock="Top" Text="原始" Foreground="#6B7280" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding InputText, Mode=OneWay}" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Background="#F9FAFB" BorderThickness="0" />
                                </DockPanel>
                                <DockPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="润色后" Foreground="#6B7280" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Background="#F9FAFB" BorderThickness="0" />
                                </DockPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="#374151"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" />
                <Button Content="润 色" Command="{Binding PolishCommand}"
                        IsEnabled="{Binding CanPolish}"
                        Background="#2563EB" Foreground="White" BorderBrush="#2563EB"
                        FontWeight="SemiBold" Padding="28,8" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
